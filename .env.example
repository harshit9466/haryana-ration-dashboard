# ─────────────────────────────────────────────────────────────────────
#  Copy to .env aur values bharo.   cp .env.example .env
#  .env gitignored hai — asli secrets kabhi commit mat karna.
# ─────────────────────────────────────────────────────────────────────

# ── Government ePOS API ──────────────────────────────────────────────
EPOS_BASE_URL="https://epos.haryanafood.gov.in"
DEFAULT_DIST_CODE="073"          # 073 = Rohtak
DEFAULT_AFSO_CODE="15019"        # 15019 = Pr Centre Rohtak (API 1 ke liye)
DEFAULT_SRC_NO="000000000000"    # apna ration card (SRC) number — asli value sirf .env / Railway me

# ── Auth ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD="change-me"                       # poori site ka password (HTTP Basic)
CRON_SECRET="generate-a-long-random-string"      # cron -> /api/cron/poll shared secret

# ── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"     # resend.com/api-keys
EMAIL_FROM="onboarding@resend.dev"               # shared sender — sirf account-owner email pe bhejta hai
NOTIFY_EMAIL="you@example.com"                   # admin form me prefill hone wali email

# ── Database (PostgreSQL) ────────────────────────────────────────────
# Local:  docker compose up -d db   (host port 5433 — 5432 aksar busy hota hai)
# Railway: Postgres plugin add karo, ye apne aap inject ho jaata hai
DATABASE_URL="postgresql://ration:ration@localhost:5433/ration?schema=public"

# ── Misc ─────────────────────────────────────────────────────────────
TZ="Asia/Kolkata"

# ── cron service ke liye extra (Railway pe alag service) ─────────────
# WEB_URL="https://<your-web-service>.up.railway.app"
