# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets stay local; .env.example is committed
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated on install via postinstall)
/src/generated/prisma

# next 16 concurrent dev/build + profiling
/.next-profiles/
/.next-docs/

# editors
/.idea/
/.vscode/

# vendor agent-skill caches (manifest `skills-lock.json` is committed; content is re-fetchable + in node_modules)
/.agents/
/.claude/
/.windsurf/
