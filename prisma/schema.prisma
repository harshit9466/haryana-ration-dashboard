// Haryana Ration Dashboard — database schema
// Docs: https://pris.ly/d/prisma-schema
//
// This DB only backs the MONITOR feature (settings + per-shop config + per-day
// state + email log). Ration / stock / transaction data is never stored — it is
// always fetched live from the government API.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Global monitor settings. Single row (id = 1).
model Settings {
  id           Int      @id @default(1)
  notifyEmails String[] // recipients for the status emails
  /// IST "HH:mm" times at which to send a combined status report. The last one
  /// of the day is effectively the end-of-day report.
  reportTimes  String[] @default(["09:30", "11:30", "14:00", "18:00", "21:00"])
  updatedAt    DateTime @updatedAt

  @@map("settings")
}

/// One monitored Fair Price Shop. Managed from the admin page.
model MonitorConfig {
  id          Int      @id @default(autoincrement())
  fpsId       String   @unique
  label       String // dealer name (from the master list), display only
  distCode    String   @default("073")
  pollEnabled Boolean  @default(true)
  /// Per-shop override. If non-empty, this shop is excluded from the global
  /// report and gets its own email at these IST "HH:mm" times instead.
  reportTimes String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("monitor_config")
}

/// One monitored shop's state for one day (for the admin display). New row per
/// day, lazily.
model DailyMonitorState {
  id               Int       @id @default(autoincrement())
  fpsId            String
  date             String // IST "YYYY-MM-DD"
  openedAt         DateTime? // when we first saw a transaction today
  firstTxnAt       String? // government loginTime of that first transaction
  lastSeenTxnCount Int       @default(0)
  lastPolledAt     DateTime?

  @@unique([fpsId, date])
  @@map("daily_monitor_state")
}

/// Which report times have already been emailed for a given day and scope.
/// scope = "global" or a specific fpsId (for per-shop overrides).
model DailyReportState {
  id        Int      @id @default(autoincrement())
  date      String // IST "YYYY-MM-DD"
  scope     String // "global" | fpsId
  sentTimes String[] @default([])

  @@unique([date, scope])
  @@map("daily_report_state")
}

/// A record of every email sent — for debugging ("why didn't I get the mail").
model EmailLog {
  id      Int      @id @default(autoincrement())
  fpsId   String?
  kind    String // "report" | "test"
  to      String
  subject String
  ok      Boolean
  error   String?
  sentAt  DateTime @default(now())

  @@map("email_log")
}
