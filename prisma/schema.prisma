// Haryana Ration Dashboard — database schema
// Docs: https://pris.ly/d/prisma-schema
//
// This DB only backs the MONITOR feature (settings + per-shop config + per-day
// state + email log). Ration / stock / transaction data is never stored — it is
// always fetched live from the government API.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Global monitor settings. Single row (id = 1).
model Settings {
  id               Int      @id @default(1)
  notifyEmails     String[] // recipients for both digest emails
  pollFrom         String   @default("05:00") // IST "HH:mm" — don't poll before this
  openedDigestTime String   @default("13:00") // IST "HH:mm" — send "shops opened" digest by this time
  eodDigestTime    String   @default("21:00") // IST "HH:mm" — send end-of-day digest at this time
  updatedAt        DateTime @updatedAt

  @@map("settings")
}

/// One monitored Fair Price Shop. Managed from the admin page.
model MonitorConfig {
  id             Int      @id @default(autoincrement())
  fpsId          String   @unique
  label          String // dealer name (from the master list), display only
  distCode       String   @default("073")
  pollEnabled    Boolean  @default(true)
  /// If set, this shop is excluded from the "shops opened" digest and gets its
  /// own opened email at this IST "HH:mm" instead.
  openedOverride String?
  /// If set, this shop is excluded from the end-of-day digest and gets its own
  /// EOD email at this IST "HH:mm" instead.
  eodOverride    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("monitor_config")
}

/// One monitored shop's state for one day. New row per day (lazily). This is
/// where idempotency comes from.
model DailyMonitorState {
  id                   Int       @id @default(autoincrement())
  fpsId                String
  date                 String // IST "YYYY-MM-DD"
  openedAt             DateTime? // set when we first detected a transaction today
  firstTxnAt           String? // government loginTime of that first transaction
  lastSeenTxnCount     Int       @default(0)
  lastPolledAt         DateTime?
  overrideOpenedSentAt DateTime? // per-shop opened email sent (openedOverride shops)
  overrideEodSentAt    DateTime? // per-shop EOD email sent (eodOverride shops)

  @@unique([fpsId, date])
  @@map("daily_monitor_state")
}

/// The two combined digest emails for one day. New row per day.
model DailyDigestState {
  id                 Int       @id @default(autoincrement())
  date               String    @unique // IST "YYYY-MM-DD"
  openedDigestSentAt DateTime?
  eodDigestSentAt    DateTime?

  @@map("daily_digest_state")
}

/// A record of every email sent — for debugging ("why didn't I get the mail").
model EmailLog {
  id      Int      @id @default(autoincrement())
  fpsId   String?
  kind    String // "opened-digest" | "eod-digest" | "opened" | "eod" | "test"
  to      String
  subject String
  ok      Boolean
  error   String?
  sentAt  DateTime @default(now())

  @@map("email_log")
}
